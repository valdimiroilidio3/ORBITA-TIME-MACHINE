# ─── ORBITA Time Machine ─────────────────────────────────────────────────────
# Segredo de assinatura de sessões e cookies de showcase (obrigatório em produção)
ORBITA_SESSION_SECRET=change-me-with-openssl-rand-hex-32

# Entrada automática no dashboard em desenvolvimento (ignorado em produção)
ORBITA_DEV_AUTOLOGIN=true

# Operador inicial (criado no primeiro arranque)
ORBITA_ADMIN_EMAIL=admin@orbita.pt
ORBITA_ADMIN_PASSWORD=orbita-time-machine
ORBITA_MEMBER_EMAIL=equipa@orbita.pt
ORBITA_MEMBER_PASSWORD=equipa-time-machine

# Diretório de dados (SQLite + artefactos). Fora do Git por convenção.
ORBITA_DATA_DIR=./data

# ─── Fornecedor de IA ───────────────────────────────────────────────────────
# auto = usa provider remoto se houver chave, senão motor local determinístico
AI_PROVIDER=auto                 # auto | openai | anthropic | local
AI_API_KEY=
AI_BASE_URL=                     # ex.: https://api.openai.com/v1
AI_MODEL=                        # ex.: gpt-4o-mini | claude-3-5-sonnet-latest
AI_MAX_OUTPUT_TOKENS=3500
AI_TIMEOUT_MS=45000

# ─── Captura de websites ────────────────────────────────────────────────────
CAPTURE_ENABLED=true
CAPTURE_NAV_TIMEOUT_MS=30000
CAPTURE_MAX_PAGES=3
CAPTURE_MAX_BYTES=8000000

# ─── Limites de utilização / custos ─────────────────────────────────────────
LIMIT_MAX_CONCURRENT_JOBS=2
LIMIT_RUNS_PER_HOUR=12
LIMIT_MAX_COST_CENTS_PER_TM=250
LIMIT_MAX_AI_CALLS_PER_TM=8

# ─── Showcase / contacto comercial ──────────────────────────────────────────
SHOWCASE_LINK_TTL_DAYS=30
NEXT_PUBLIC_ORBITA_CONTACT_EMAIL=hello@orbita.pt
NEXT_PUBLIC_ORBITA_WHATSAPP=351900000000
